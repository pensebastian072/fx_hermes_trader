# FX Hermes Trader - example environment file.
# Copy to .env and fill in values. NEVER commit a real .env file.
# Milestone 1 needs no secrets at all. No broker API keys exist in this project.

# Override the data directory (defaults to ./data)
# FXHT_DATA_DIR=

# Webhook bind settings (used when running uvicorn manually)
# FXHT_HOST=127.0.0.1
# FXHT_PORT=8000

# Placeholder for a future local LLM endpoint (Ollama / llama.cpp). NOT used in Milestone 1.
# FXHT_LOCAL_LLM_URL=http://127.0.0.1:11434
